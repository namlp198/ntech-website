# Local development only. Copy to .env and replace every CHANGE_ME value.
NODE_ENV=development
DATABASE_URL=postgresql://ntech_ai:CHANGE_ME@localhost:5432/ntech_ai?schema=public
BETTER_AUTH_URL=http://localhost:3000
# Generate at least 32 random bytes, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Optional, used only by the explicit owner seed command.
# No account is created automatically when the app or database starts.
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=
# Required in production only, to acknowledge an intentional privileged seed.
ALLOW_PRODUCTION_OWNER_SEED=false

# Development database container. Do not reuse these values in production.
POSTGRES_DB=ntech_ai
POSTGRES_USER=ntech_ai
POSTGRES_PASSWORD=CHANGE_ME

# Integrations remain disabled until real approved credentials exist.
EMAIL_NOTIFICATIONS_ENABLED=false
ZALO_NOTIFICATIONS_ENABLED=false
OBJECT_STORAGE_ENABLED=false

